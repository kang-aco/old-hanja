# Anthropic API 키 — https://console.anthropic.com/settings/keys
# 같은 값을 .dev.vars 에도 넣어야 로컬 wrangler(D1) 환경에서 읽습니다.
ANTHROPIC_API_KEY=sk-ant-api03-...

# 디버그 화면 열쇠 (선택) — 주소에 ?debug=<이 값> 을 붙이면 층별 관측이 열립니다.
# 시스템 프롬프트 전문과 AI 원본 응답이 그대로 실리므로 Secret 으로 취급하십시오.
#
# ※ 반드시 16자 이상이어야 합니다. 16자 미만이면 미설정으로 취급해 무시합니다 —
#   DEBUG_KEY=1 처럼 짧으면 ?debug=1 같은 추측값이 우연히 맞기 때문입니다.
#   설정했는데 화면이 열리지 않으면 먼저 길이부터 확인하십시오.
# 미설정이면 디버그 화면은 완전히 꺼집니다(응답에 debug 필드가 생기지 않음).
DEBUG_KEY=
