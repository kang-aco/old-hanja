---
import Base from '../layouts/Base.astro';

export const prerender = true;

const STEPS = [
  {
    no: 1,
    title: '한자 독음 확인',
    body: '각 한자의 음(音)과 훈(訓)을 먼저 확인합니다. 같은 글자가 문맥에 따라 다르게 읽히는 경우를 놓치지 않는 것이 중요합니다.',
    example: '說 — 보통은 「설(말씀)」이지만, 不亦說乎 에서는 「열(기쁘다)」로 읽습니다.',
  },
  {
    no: 2,
    title: '품사 판별',
    body: '한문은 형태 변화가 없어 같은 글자가 명사·동사·형용사로 두루 쓰입니다. 문장 안의 위치로 품사를 판단합니다.',
    example: '君君臣臣 — 앞의 君은 명사(임금), 뒤의 君은 동사(임금답게 행하다).',
  },
  {
    no: 3,
    title: '생략 요소 복원',
    body: '주어와 목적어가 자주 생략됩니다. 앞뒤 문맥에서 무엇이 빠졌는지 채워 넣어야 문장이 완성됩니다.',
    example: '學而時習之 — 주어가 없습니다. 문맥상 「배우는 사람이면 누구나」로 일반화해 읽습니다.',
  },
  {
    no: 4,
    title: '도치(倒置) 복원',
    body: '부정문·의문문에서 목적어가 동사 앞으로 나오는 등 어순이 뒤바뀝니다. 원래 자리로 되돌려 놓고 해석합니다.',
    example: '不吾知也 → 不知吾也 (나를 알아주지 않는다). 부정문에서 목적어 吾가 앞으로 갔습니다.',
  },
  {
    no: 5,
    title: '조사·어미 해석',
    body: '之·而·於·以·者·所·則·乎·也·矣·焉 같은 허사(虛辭)가 문장의 골격을 결정합니다. 실질 한자보다 먼저 잡아야 합니다.',
    example: '之 — 목적어(그것)일 때와 관형격(~의)일 때를 구별합니다. 學而時習之 의 之는 「배운 것」.',
  },
  {
    no: 6,
    title: '문맥적 해석',
    body: '출전과 앞뒤 문장을 함께 봅니다. 같은 구절도 어느 책 어느 편에 있는지에 따라 뜻이 달라집니다.',
    example: '道 — 논어에서는 사람이 걸어야 할 도리, 노자에서는 만물의 근원을 가리킵니다.',
  },
  {
    no: 7,
    title: '현대어 번역',
    body: '직역으로 구조를 확인한 뒤, 의역으로 자연스럽게 다듬습니다. 두 가지를 나란히 두면 어디서 의미가 더해졌는지 보입니다.',
    example: '직역 「배우고 때때로 그것을 익히면」 → 의역 「배운 것을 꾸준히 되새기면」.',
  },
];

const HELPERS = [
  ['之', '지', '① 그것(목적어) ② ~의(관형격) ③ 가다(동사)'],
  ['而', '이', '① 그리고(순접) ② 그러나(역접) ③ 너(대명사, 드묾)'],
  ['於', '어', '① ~에서·~에게 ② ~보다(비교) ③ ~에 의해(피동)'],
  ['以', '이', '① ~로써(수단) ② ~때문에(이유) ③ 以A爲B = A를 B로 삼다'],
  ['者', '자', '① ~하는 사람 ② ~하는 것 ③ 주어를 제시하는 표지'],
  ['所', '소', '所+동사 = ~하는 바. 뒤에 오는 동작의 대상을 명사로 만든다'],
  ['則', '즉', 'A則B = A하면 곧 B하다'],
  ['乎', '호', '① ~인가(의문) ② ~로다(감탄) ③ 於와 같은 전치사'],
  ['也', '야', '① ~이다(단정) ② 주어 뒤에서 잠시 끊어 주는 표지'],
  ['矣', '의', '~하였다·~이다. 완료·확정의 어감'],
  ['焉', '언', '① 어찌(의문부사) ② 於之의 축약(거기에)'],
  ['雖', '수', '雖~ = 비록 ~하더라도'],
];
---

<Base title="한문 번역 7단계 — 한문독해" tagline="구절을 만나면 이 순서로 읽습니다">
  <p class="chips-label" style="margin-top:22px">방법론</p>
  {
    STEPS.map((s) => (
      <div class="card">
        <h4>
          {s.no}. {s.title}
        </h4>
        <p>{s.body}</p>
        <p class="meta">{s.example}</p>
      </div>
    ))
  }

  <p class="chips-label" style="margin-top:32px">자주 나오는 허사(虛辭) 열두 자</p>
  <p class="empty" style="font-size:13px">
    실질 한자의 뜻을 다 알아도 허사를 놓치면 문장이 풀리지 않습니다. 먼저 이것부터 익히세요.
  </p>
  {
    HELPERS.map(([hanja, eum, body]) => (
      <div class="card">
        <h4>
          <span class="hanja" style="font-size:24px">
            {hanja}
          </span>
          <span style="color:var(--ink-3);font-size:13px;margin-left:6px">{eum}</span>
        </h4>
        <p>{body}</p>
      </div>
    ))
  }

  <p class="chips-label" style="margin-top:32px">
    <a href="/" style="color:var(--accent)">← 구절 풀이로 돌아가기</a>
  </p>
</Base>
